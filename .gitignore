# Public ATLAS source files. Other root paths stay local.
/*
!/.env.example
!/.github/
!/.gitignore
!/AGENTS.md
!/CHANGELOG.md
!/CITATION.cff
!/CONTRIBUTING.md
!/LICENSE
!/Makefile
!/README.md
!/SECURITY.md
!/pyproject.toml
!/requirements.lock
!/requirements-dev.lock
!/config/
!/docs/
!/examples/
!/schemas/
!/scripts/
!/src/
!/tests/
!/types/

# Credentials and local tooling, including files inside source directories.
.env
.env.*
!/.env.example
.DS_Store
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.venv/
*.sqlite*
*.db
*.db-wal
*.db-shm
*.log

# Operational state and generated outputs, wherever they are created.
.runtime-state/
.local/
state/
reports/
data/
exports/
output/
outputs/
demo-output/
replay-output/
approved-release/
generated-schemas/
dist/
build/
INSTALLATION_REPORT.md
