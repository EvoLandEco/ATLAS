    "DateValue": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/Status",
          "default": "not_reported"
        },
        "value": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Complete date in YYYY-MM-DD form. Use null when the day is not reported.",
          "title": "Value"
        }
      },
      "title": "DateValue",
      "type": "object"
    },
    "Disease": {
      "additionalProperties": false,
