    "methods": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "combination": {
            "const": "equal_weight_quantile_median"
          },
          "require_all_components": {
            "const": true
          },
          "components": {
            "const": [
              {
                "model_id": "random_walk",
                "weight": 0.3333333333333333
              },
              {
                "model_id": "recent_changes",
                "weight": 0.3333333333333333
              },
              {
                "model_id": "gamma_poisson",
                "weight": 0.3333333333333333
              }
            ]
          }
        },
        "required": [
          "id",
          "label",
          "description",
          "url"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "id": {
                  "const": "ensemble_median"
                }
              }
            },
            "then": {
              "required": [
                "combination",
                "require_all_components",
                "components"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "combination"
                    ]
                  },
                  {
                    "required": [
                      "require_all_components"
                    ]
                  },
                  {
                    "required": [
                      "components"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    },
